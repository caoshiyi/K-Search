diff --git a/agent_workdir/flash_attention/kernel/matmul_tile.h b/agent_workdir/flash_attention/kernel/matmul_tile.h
index 3576900..7a7b572 100644
--- a/agent_workdir/flash_attention/kernel/matmul_tile.h
+++ b/agent_workdir/flash_attention/kernel/matmul_tile.h
@@ -87,6 +87,40 @@ __aicore__ inline void LoadNzL1ToZnL0B(const AscendC::LocalTensor<T> &dst,
     AscendC::LoadData(dst, src, params);
 }
 
+// L1(Nz) -> L0B(Zn), extract an n sub-block from a wider L1 big block.
+// Params:
+//   dst         : L0B target (Zn layout), single sub-block k x n
+//   src         : L1 source pointer, already offset to the n sub-block / k-tile
+//   k           : k dim of current K-tile (BASE_K=128, tail = kAligned)
+//   n           : aligned rows of current n sub-block (nRowsAlign, usually 128)
+//   colC0Stride : NZ col stride of the L1 big block (= kvRowsAlign, 256 or 128)
+template<typename T>
+__aicore__ inline void LoadNzL1ToZnL0BWithTranspose(
+        const AscendC::LocalTensor<T> &dst,
+        const AscendC::LocalTensor<T> &src,
+        uint32_t k, uint32_t n, uint32_t colC0Stride)
+{
+    constexpr uint32_t c0 = 32 / sizeof(T);     // half/bf16 -> 16
+    AscendC::LoadData2DParams p;
+    p.startIndex  = 0;
+    p.srcStride   = 1;
+    p.dstGap      = 0;
+    p.ifTranspose = false;
+    if (colC0Stride == n) {
+        // Degenerate branch: L1 block width == n sub-block -> byte-identical to
+        // baseline single LoadData2D.
+        p.repeatTimes = (k / c0) * (n / c0);
+        AscendC::LoadData(dst, src, p);
+    } else {
+        // Big-block branch: L1 width colC0Stride > n, extract per C0 row.
+        p.repeatTimes = n / c0;
+        for (uint32_t i = 0; i < (k / c0); ++i) {
+            AscendC::LoadData(dst[(uint64_t)n * i * c0],
+                              src[(uint64_t)colC0Stride * i * c0], p);
+        }
+    }
+}
+
