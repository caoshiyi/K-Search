+                    if (t >= PRELAUNCH) {
+                        uint32_t o = t - PRELAUNCH;
+                        int slot = o % RING_SLOTS;
+                        bool isFirst = (o == 0);
+                        bool isLast = (o == s2OuterBlocks - 1);
+                        vecKernel_.ComputeVec2(slot, isFirst, isLast);
+                    }
+                    if (t < s2OuterBlocks) {
+                        uint32_t s2Start = t * s2BaseSize;
